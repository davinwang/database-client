# database-client configuration template
#
# Usage: copy the lines you need into the project's .env (or .env.local / .env.<env>).
#        The CLI re-reads it on every invocation; **the skill itself stores no connection info**.
#
# Priority (high to low):
#   command-line flags > process environment > --env-file > .env.<profile>.local > .env.<profile> > .env.local > .env
# Lower-priority fallbacks: services in docker-compose.yml, Spring application.yml/properties
#
# Naming conventions:
#   DB_URL                      single-database projects (connection name is default)
#   DB_<name>_URL               multi-database projects (select with --db <name>)
#   DB_<name>_TYPE/HOST/PORT/USER/PASSWORD/DATABASE/SCHEMA/SSL/DIALECT/FILE
# When the name contains the type you can omit TYPE, e.g. DB_REDIS_URL / DB_MYSQL_HOST.
#
# Supported TYPE values:
#   mysql | oceanbase | postgres | oracle | dameng | sqlserver | sqlite
#   mongodb | redis | clickhouse | elasticsearch
#   Aliases: tidb/tdsql/polardb/goldendb -> mysql, kingbase/vastbase/gaussdb/opengauss -> postgres

# -- Single-database projects (most common) --
# DB_URL=mysql://app:<password>@127.0.0.1:3306/appdb
# DB_URL=postgres://app:<password>@10.0.0.5:5432/erp
# DB_URL=oracle://app:<password>@ora-host:1521/ORCLPDB1
# DB_URL=sqlserver://sa:<password>@mssql:1433/appdb
# DB_URL=sqlite:./data/app.db
# DB_URL=redis://:<password>@127.0.0.1:6379/0
# DB_URL=mongodb://app:<password>@127.0.0.1:27017/appdb?authSource=admin
# DB_URL=kafka://10.0.0.7:9092,10.0.0.8:9092        # Kafka: comma-separated brokers
# DB_URL=http://user:<password>@ch-host:8123/default        # ClickHouse HTTP interface
# DB_URL=http://elastic:<password>@es-host:9200             # Elasticsearch (ES_URL works too)
# DB_URL=jdbc:mysql://db:3306/core?useUnicode=true    # JDBC strings are accepted; paste them from Java projects

# -- Multi-database projects (select with --db <name>) --
# DB_ERP_URL=mysql://app:<password>@10.0.0.5:3306/erp
# DB_LOG_URL=postgres://log:<password>@10.0.0.6:5432/logdb
# DB_DEFAULT=erp                                      # connection used when --db is omitted

# -- Segmented form (when the password has special characters or config is split across lines) --
# DB_REPORT_TYPE=postgres
# DB_REPORT_HOST=pg-report
# DB_REPORT_PORT=5433
# DB_REPORT_USER=report
# DB_REPORT_PASSWORD=<password>
# DB_REPORT_DATABASE=dw
# DB_REPORT_SCHEMA=mart

# -- OceanBase: MySQL protocol; add MODE for Oracle mode --
# DB_OB_URL=oceanbase://root:<password>@ob-host:2881/app
# DB_OB_MODE=oracle                                   # oracle | mysql (default mysql)

# -- Kafka / Redpanda (read-only troubleshooting) --
# KAFKA_BROKERS=10.0.0.7:9092,10.0.0.8:9092
# KAFKA_SASL_USERNAME=app
# KAFKA_SASL_PASSWORD=<password>
# KAFKA_SASL_MECHANISM=scram-sha-256                  # plain | scram-sha-256 | scram-sha-512
# KAFKA_SSL=true
# Or all in one string: KAFKA_URL=kafka://10.0.0.7:9092,10.0.0.8:9092?ssl=true&saslMechanism=scram-sha-256

# -- DM8 / Dameng (needs the official dmdb driver, see README) --
# DB_DM_URL=dm://SYSDBA:<password>@dm-host:5236

# -- Common ecosystem variables (use them without renaming your project config) --
# MYSQL_HOST / MYSQL_PORT / MYSQL_USER / MYSQL_PASSWORD / MYSQL_DATABASE
# PGHOST / PGPORT / PGUSER / PGPASSWORD / PGDATABASE / PGSSLMODE
# REDIS_URL or REDIS_HOST / REDIS_PORT / REDIS_PASSWORD / REDIS_DB
# MONGO_URI or MONGODB_URI
# CLICKHOUSE_URL or CLICKHOUSE_HOST / CLICKHOUSE_PORT / CLICKHOUSE_USER / CLICKHOUSE_PASSWORD
# ES_URL or ELASTICSEARCH_URL / ELASTICSEARCH_USER / ELASTICSEARCH_PASSWORD
# SPRING_DATASOURCE_URL / SPRING_DATASOURCE_USERNAME / SPRING_DATASOURCE_PASSWORD
# JDBC_URL / JDBC_USER / JDBC_PASSWORD

# -- Optional runtime switches --
# DB_DEFAULT=erp            # default connection name
# DB_DRIVER_DIR=D:\dbcli-drivers   # where on-demand drivers go (defaults to the skill directory)
# DB_DRIVER_TGZ / DB_DM_DRIVER_TGZ # path to the official Dameng driver tgz
